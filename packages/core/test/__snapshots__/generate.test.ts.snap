  "web/README.md" => "# my-app

Stack: React 19, Vite, TypeScript, Express, MongoDB, Better Auth.

## Getting started

\`\`\`bash
npm install
npm run dev
\`\`\`

## Scripts

- \`npm run build\`
- \`npm run preview\`
- \`npm run typecheck\`

## API

The API lives in \`../server\` (Express). Start it with \`npm run dev\` there; requests to \`/api\` from this app are proxied to it in development.

## Push to GitHub

Create an empty repository on GitHub, then:

\`\`\`bash
git init
git add .
git commit -m "Initial commit"
git branch -M main
git remote add origin https://github.com/<your-username>/my-app.git
git push -u origin main
\`\`\`
",
  "web/src/App.tsx" => "import ApiGreeting from "./components/ApiGreeting";
import AuthPanel from "./components/AuthPanel";
import Counter from "./components/Counter";

export default function App() {
  return (
    <main className="app">
      <h1 className="title">my-app</h1>
      <Counter />
      <ApiGreeting />
      <AuthPanel />
    </main>
  );
}
",
  "web/src/components/ApiGreeting.tsx" => "import { useEffect, useState } from "react";

export default function ApiGreeting() {
  const [message, setMessage] = useState("Calling the API…");

  useEffect(() => {
    fetch("/api/hello?name=my-app")
      .then((response) => {
        if (!response.ok) throw new Error(\`HTTP \${response.status}\`);
        return response.json();
      })
      .then((data) => setMessage(data.message))
      .catch(() => setMessage("The API isn't running: start it in server/."));
  }, []);

  return <p className="text">{message}</p>;
}
",
  "web/src/components/AuthPanel.tsx" => "import type { FormEvent } from "react";
import { useState } from "react";
import { authClient } from "../lib/auth-client";

export default function AuthPanel() {
  const { data: session, isPending } = authClient.useSession();
  const [mode, setMode] = useState<"sign-in" | "sign-up">("sign-in");
  const [error, setError] = useState("");

  if (isPending) return <p className="text">Checking your session…</p>;

  if (session) {
    return (
      <div className="form">
        <p className="text">
          Signed in as {session.user.name} ({session.user.email}).
        </p>
        <button
          type="button"
          className="btn"
          onClick={() => authClient.signOut()}
        >
          Sign out
        </button>
      </div>
    );
  }

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const form = new FormData(event.currentTarget);
    const email = String(form.get("email"));
    const password = String(form.get("password"));
    const { error } =
      mode === "sign-up"
        ? await authClient.signUp.email({
            name: String(form.get("name")),
            email,
            password,
          })
        : await authClient.signIn.email({ email, password });
    // A network failure has no message: the proxy got no answer from the API.
    setError(
      error
        ? (error.message ?? "The API isn't running: start it in server/.")
        : "",
    );
  }

  const signingUp = mode === "sign-up";
  return (
    <form className="form" onSubmit={submit}>
      {signingUp && (
        <label className="field">
          Name
          <input name="name" required autoComplete="name" className="input" />
        </label>
      )}
      <label className="field">
        Email
        <input
          type="email"
          name="email"
          required
          autoComplete="email"
          className="input"
        />
      </label>
      <label className="field">
        Password
        <input
          type="password"
          name="password"
          required
          minLength={8}
          autoComplete={signingUp ? "new-password" : "current-password"}
          className="input"
        />
      </label>
      {error && (
        <p role="alert" className="error">
          {error}
        </p>
      )}
      <button type="submit" className="btn">
        {signingUp ? "Create account" : "Sign in"}
      </button>
      <button
        type="button"
        className="link"
        onClick={() => {
          setMode(signingUp ? "sign-in" : "sign-up");
          setError("");
        }}
      >
        {signingUp ? "Have an account? Sign in" : "New here? Create an account"}
      </button>
    </form>
  );
}
",
  "web/src/components/Counter.tsx" => "import { useState } from "react";

export default function Counter() {
  const [count, setCount] = useState(0);

  return (
    <div className="card">
      <p className="count">{count}</p>
      <div className="row">
        <button
          type="button"
          className="btn"
          onClick={() => setCount((n) => n - 1)}
        >
          -1
        </button>
        <button
          type="button"
          className="btn"
          onClick={() => setCount((n) => n + 1)}
        >
          +1
        </button>
      </div>
    </div>
  );
}
",
