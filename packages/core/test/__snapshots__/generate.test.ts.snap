      <p class="max-w-md text-center text-slate-600">
        Built with SolidJS, Vite, TypeScript, Sass, Tailwind CSS, Solid signals
        store, Solid Router, Axios, TanStack Query, TanStack Form, Zod,
        Playwright, Vitest, Testing Library, ESLint, Prettier, Husky,
        lint-staged, SEO, llms.txt, PWA, GitHub Actions.
      </p>
    </section>
  );
}
