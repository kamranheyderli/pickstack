  "e2e/app.e2e.js": "import { expect, test } from "@playwright/test";

test("the counter goes up", async ({ page }) => {
  await page.goto("/");
  // Clicks before hydration are lost, so retry until the count changes.
  await expect(async () => {
    await page.getByRole("button", { name: "+1" }).click();
    await expect(page.getByText("1", { exact: true })).toBeVisible({
      timeout: 1000,
    });
  }).toPass();
});

test("the about page opens from the nav", async ({ page }) => {
  await page.goto("/");
  await page.getByRole("link", { name: "About" }).click();
  await expect(page).toHaveURL(/about/);
  await expect(page.getByRole("heading", { name: "About" })).toBeVisible();
});
",
  "eslint.config.js": "import path from "node:path";
import js from "@eslint/js";
import { defineConfig, includeIgnoreFile } from "eslint/config";
import eslintConfigPrettier from "eslint-config-prettier/flat";
import svelte from "eslint-plugin-svelte";
import globals from "globals";

const gitignorePath = path.resolve(import.meta.dirname, ".gitignore");

export default defineConfig(
  includeIgnoreFile(gitignorePath),
  js.configs.recommended,
  svelte.configs.recommended,
  eslintConfigPrettier,
  svelte.configs.prettier,
  {
    languageOptions: {
      globals: { ...globals.browser, ...globals.node },
    },
  },
  {
    // shadcn-svelte's Button renders whatever \`href\` it receives; callers pass resolve()d paths.
    files: ["src/lib/components/ui/**/*.svelte"],
    rules: { "svelte/no-navigation-without-resolve": "off" },
  },
);
