  "src/components/CounterCard.vue": "<script setup lang="ts">
import { ref } from "vue";

const count = ref(0);
</script>

<template>
  <div class="card">
    <p class="count">{{ count }}</p>
    <div class="row">
      <button type="button" class="btn" @click="count--">-1</button>
      <button type="button" class="btn" @click="count++">+1</button>
    </div>
  </div>
</template>
