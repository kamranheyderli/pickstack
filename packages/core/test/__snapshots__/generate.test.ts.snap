export default function Counter() {
  const [count, setCount] = createSignal(0);

  return (
    <div class="card">
      <p class="count">{count()}</p>
      <div class="row">
        <button
          type="button"
          class="btn"
          onClick={() => setCount((value) => value - 1)}
        >
          -1
        </button>
        <button
          type="button"
          class="btn"
          onClick={() => setCount((value) => value + 1)}
        >
          +1
        </button>
      </div>
    </div>
  );
}
