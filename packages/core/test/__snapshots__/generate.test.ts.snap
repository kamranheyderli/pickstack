",
  "README.md" => "# my-app

A web app and its API, as two projects:

- \`web/\`: the app. In development its dev server proxies \`/api\` to the API.
- \`server/\`: Express 5 API on port 3001, with MongoDB (Mongoose), with Better Auth.

## Getting started

Start MongoDB (needs Docker), or point \`MONGODB_URI\` in \`server/.env\` at your own instance:

\`\`\`bash
docker compose up -d
\`\`\`

Give Better Auth a secret: copy \`server/.env.example\` to \`server/.env\` and set \`BETTER_AUTH_SECRET\`, e.g. to the output of:

\`\`\`bash
openssl rand -base64 32
\`\`\`

Start the API, then the app, in two terminals:

\`\`\`bash
cd server && npm install && npm run dev
\`\`\`

\`\`\`bash
cd web && npm install && npm run dev
\`\`\`
",
  "server/.env.example" => "PORT=3001
MONGODB_URI=mongodb://localhost:27017/my-app
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
",
  "server/.gitignore" => "node_modules
dist
.env
",
  "server/package.json" => "{
  "name": "my-app-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.7.28",
    "express": "^5.3.0",
    "mongodb": "^7.9.1",
    "mongoose": "^9.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
",
  "server/README.md" => "# my-app-server

Express 5 API on port 3001, with MongoDB (Mongoose), with Better Auth. Copy \`.env.example\` to \`.env\` to change settings.

\`\`\`bash
npm install
npm run dev
\`\`\`
",
  "server/src/app.ts" => "import { fromNodeHeaders, toNodeHandler } from "better-auth/node";
import express from "express";
import { auth } from "./auth.js";
import { Todo } from "./models/todo.js";

export const app = express();

// Better Auth reads its own request bodies, so it goes before express.json().
app.all("/api/auth/{*any}", toNodeHandler(auth));

app.use(express.json());

app.get("/api/health", (_req, res) => {
  res.json({ ok: true });
});

app.get("/api/hello", (req, res) => {
  const name = typeof req.query.name === "string" ? req.query.name : "world";
  res.json({ message: \`Hello, \${name}!\` });
});

app.get("/api/todos", async (_req, res) => {
  const todos = await Todo.find().sort({ createdAt: -1 }).limit(100);
  res.json(todos);
});

app.post("/api/todos", async (req, res) => {
  const title =
    typeof req.body?.title === "string" ? req.body.title.trim() : "";
  if (!title) {
    res.status(400).json({ error: "title is required" });
    return;
  }
  const todo = await Todo.create({ title });
  res.status(201).json(todo);
});

app.get("/api/me", async (req, res) => {
  const session = await auth.api.getSession({
    headers: fromNodeHeaders(req.headers),
  });
  if (!session) {
    res.status(401).json({ error: "Not signed in" });
    return;
  }
  res.json(session.user);
});
",
  "server/src/auth.ts" => "import { betterAuth } from "better-auth";
import { mongodbAdapter } from "better-auth/adapters/mongodb";
import { MongoClient } from "mongodb";

const client = new MongoClient(
  process.env.MONGODB_URI ?? "mongodb://localhost:27017/my-app",
);

export const auth = betterAuth({
  // The app's origin: its dev server proxies /api/auth here, so the browser sees one site.
  baseURL: process.env.BETTER_AUTH_URL ?? "http://localhost:5173",
  // The local docker-compose MongoDB is a single server, which has no transactions.
  database: mongodbAdapter(client.db()),
  emailAndPassword: { enabled: true },
});
",
  "server/src/db.ts" => "import mongoose from "mongoose";

/** Opens the connection Mongoose models use; call it once, before serving requests. */
export async function connectDb(uri: string) {
  await mongoose.connect(uri);
  console.log(\`Connected to \${mongoose.connection.name}\`);
}
",
  "server/src/index.ts" => "import process from "node:process";
import { app } from "./app.js";
import { connectDb } from "./db.js";

const port = Number(process.env.PORT ?? 3001);

await connectDb(process.env.MONGODB_URI ?? "mongodb://localhost:27017/my-app");

app.listen(port, () => {
  console.log(\`API listening on http://localhost:\${port}\`);
});
",
  "server/src/models/todo.ts" => "import { model, Schema } from "mongoose";

const todoSchema = new Schema(
  {
    title: { type: String, required: true, trim: true, maxlength: 200 },
    done: { type: Boolean, default: false },
  },
  { timestamps: true },
);

export const Todo = model("Todo", todoSchema);
",
