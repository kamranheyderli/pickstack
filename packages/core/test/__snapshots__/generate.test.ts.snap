{
  ".claude/hooks/format.mjs": "// PostToolUse hook: formats the file Claude Code just wrote or edited.
import { spawnSync } from "node:child_process";
import { existsSync } from "node:fs";
import { dirname, join, relative } from "node:path";
import process from "node:process";

let input = "";
for await (const chunk of process.stdin) input += chunk;
const file = JSON.parse(input).tool_input?.file_path;

// Run the formatter from the package that owns the file, where its config lives,
// with a path relative to it (Biome rejects absolute paths through symlinked dirs).
let root = file ? dirname(file) : undefined;
while (root && !existsSync(join(root, "package.json"))) {
  const parent = dirname(root);
  root = parent === root ? undefined : parent;
}

if (file && root) {
  spawnSync(
    "npx",
    [
      "--no-install",
      "prettier",
      "--write",
      "--ignore-unknown",
      relative(root, file),
    ],
    {
      cwd: root,
      stdio: "ignore",
      shell: process.platform === "win32",
    },
  );
}
",
  ".claude/settings.json": "{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run build *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(npm run storybook *)",
      "Bash(npm run build-storybook *)",
      "Bash(npx shadcn-svelte@latest add *)"
    ],
    "ask": ["Bash(git push *)", "Bash(npm run deploy *)"],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \\"\${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
