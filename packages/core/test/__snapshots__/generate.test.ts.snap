  "src/components/Counter.jsx": "import { count, decrement, increment } from "../stores/counter";

export default function Counter() {
  return (
    <div class="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
      <p class="text-5xl font-bold tabular-nums">{count()}</p>
      <div class="mt-6 flex justify-center gap-3">
        <button
          type="button"
          class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={decrement}
        >
          -1
        </button>
        <button
          type="button"
          class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={increment}
        >
          +1
        </button>
      </div>
    </div>
  );
}
",
  "src/components/Counter.test.jsx": "import { render, screen } from "@solidjs/testing-library";
import userEvent from "@testing-library/user-event";
import { describe, expect, it } from "vitest";
import Counter from "./Counter";

describe("Counter", () => {
  it("increments when +1 is clicked", async () => {
    const user = userEvent.setup();
    render(() => <Counter />);

