  "app/plugins/api.js": "import axios from "axios";

export default defineNuxtPlugin(() => {
  const config = useRuntimeConfig();
  const api = axios.create({
    baseURL: config.public.apiUrl,
    timeout: 10_000,
  });

  return { provide: { api } };
});
