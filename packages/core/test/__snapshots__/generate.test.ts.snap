      <p className="count">{count}</p>
      <div className="row">
        <button
          type="button"
          className="btn"
          onClick={() => setCount((n) => n - 1)}
        >
          -1
        </button>
        <button
          type="button"
          className="btn"
          onClick={() => setCount((n) => n + 1)}
        >
          +1
        </button>
      </div>
    </div>
  );
}
