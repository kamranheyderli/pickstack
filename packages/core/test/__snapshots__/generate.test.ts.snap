  "src/App.svelte": "<script>
  import { QueryClient, QueryClientProvider } from "@tanstack/svelte-query";
  import Counter from "./lib/Counter.svelte";
  import SignupForm from "./lib/SignupForm.svelte";
  import StackList from "./lib/StackList.svelte";

  const queryClient = new QueryClient();
</script>

<QueryClientProvider client={queryClient}>
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-8 bg-slate-50 p-8 text-slate-900"
  >
    <h1 class="text-3xl font-bold tracking-tight">my-app</h1>
    <Counter />
    <StackList />
    <SignupForm />
  </main>
</QueryClientProvider>
",
  "src/api/client.js": "import axios from "axios";

export const api = axios.create({
  baseURL: import.meta.env.VITE_API_URL ?? "http://localhost:3000",
  timeout: 10_000,
});
",
  "src/api/stack.js": "/** Loads the stack list served from \`public/stack.json\`. */
export async function fetchStack() {
  const response = await fetch(\`\${import.meta.env.BASE_URL}stack.json\`);
  if (!response.ok) throw new Error(\`Request failed: \${response.status}\`);
  return response.json();
}
",
  "src/app.css": "@import "tailwindcss";
