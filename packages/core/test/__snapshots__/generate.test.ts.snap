  "src/routes/llms.txt/+server.js": "import { SITE_URL } from "$app/env/public";

export const prerender = true;

export function GET() {
  const body = \`# my-app

> my-app: a web app.

## Pages

- [Home](\${SITE_URL}/)
- [About](\${SITE_URL}/about)

## Optional

- [Sitemap](\${SITE_URL}/sitemap.xml)
\`;
  return new Response(body, { headers: { "Content-Type": "text/plain" } });
}
