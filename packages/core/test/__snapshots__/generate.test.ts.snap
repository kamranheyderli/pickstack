  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,svelte})": "prettier --ignore-unknown --write"
