  "src/app/components/signup-form/signup-form.ts": "import { Component, signal } from "@angular/core";
import { injectForm, injectStore, TanStackField } from "@tanstack/angular-form";
import { z } from "zod";

const schema = z.object({
  email: z.email("Enter a valid email address."),
});

@Component({
  selector: "app-signup-form",
  imports: [TanStackField],
  templateUrl: "./signup-form.html",
})
export class SignupForm {
  protected readonly joined = signal("");
  protected readonly form = injectForm({
    defaultValues: { email: "" },
    validators: { onSubmit: schema },
    onSubmit: ({ value }) => this.joined.set(value.email),
  });
  // The template reads errors through a signal, so it updates without zone.js.
  protected readonly errors = injectStore(
    this.form,
    (state) => state.fieldMeta.email?.errors ?? [],
  );

  protected submit(event: SubmitEvent): void {
    event.preventDefault();
    void this.form.handleSubmit();
  }
}
",
