  "src/api/stack.ts": "/** Loads the stack list served from \`public/stack.json\`. */
export async function fetchStack(): Promise<string[]> {
  const response = await fetch(\`\${import.meta.env.BASE_URL}stack.json\`);
  if (!response.ok) throw new Error(\`Request failed: \${response.status}\`);
  return response.json();
}
