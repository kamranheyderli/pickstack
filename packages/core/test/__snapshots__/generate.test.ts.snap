  "src/lib/Counter.stories.ts": "import type { Meta, StoryObj } from "@storybook/svelte-vite";
import Counter from "./Counter.svelte";

const meta = {
  component: Counter,
} satisfies Meta<typeof Counter>;

export default meta;
type Story = StoryObj<typeof meta>;

export const Default: Story = {};
