  "src/stores/counter.ts": "import { createSignal } from "solid-js";

const [count, setCount] = createSignal(0);

export { count };

export function increment() {
  setCount((value) => value + 1);
}

export function decrement() {
  setCount((value) => value - 1);
}
",
