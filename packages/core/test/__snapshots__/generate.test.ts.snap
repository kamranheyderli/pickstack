  "src/routes/+layout.svelte": "<script>
  import { SITE_URL } from "$app/env/public";
  import { resolve } from "$app/paths";
  import { page } from "$app/state";
  import "./layout.css";

  let { children } = $props();

  const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "my-app",
    url: SITE_URL,
  });
  // The closing tag is split so it neither ends this block nor trips svelte-eslint-parser.
  const jsonLdScript = \`<script type="application/ld+json">\${jsonLd}</\${"script"}>\`;
</script>

<svelte:head>
  <meta name="description" content="my-app: a web app." />
  <link rel="canonical" href={SITE_URL + page.url.pathname} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="my-app" />
  <meta property="og:url" content={SITE_URL + page.url.pathname} />
  <meta name="twitter:card" content="summary" />
  <!-- eslint-disable-next-line svelte/no-at-html-tags -->
  {@html jsonLdScript}
</svelte:head>

<main
  class="flex min-h-screen flex-col items-center justify-center gap-8 bg-slate-50 p-8 text-slate-900"
>
  <nav class="flex gap-4 text-sm font-medium">
    <a class="text-slate-600 hover:text-slate-900" href={resolve("/")}>Home</a>
    <a class="text-slate-600 hover:text-slate-900" href={resolve("/about")}>
      About
    </a>
  </nav>
  {@render children()}
</main>
",
