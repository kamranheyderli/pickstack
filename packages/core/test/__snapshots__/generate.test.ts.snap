  timeout: 10_000,
});
",
  "src/api/stack.js": "/** Loads the stack list served from \`public/stack.json\`. */
export async function fetchStack() {
  const response = await fetch(\`\${import.meta.env.BASE_URL}stack.json\`);
  if (!response.ok) throw new Error(\`Request failed: \${response.status}\`);
  return response.json();
}
",
  "src/components/Counter.jsx": "import { count, decrement, increment } from "../stores/counter";

export default function Counter() {
  return (
    <div class="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
      <p class="text-5xl font-bold tabular-nums">{count()}</p>
      <div class="mt-6 flex justify-center gap-3">
        <button
          type="button"
          class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={decrement}
        >
          -1
        </button>
        <button
          type="button"
          class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={increment}
        >
          +1
        </button>
      </div>
    </div>
  );
}
",
  "src/components/Counter.test.jsx": "import { render, screen } from "@solidjs/testing-library";
import userEvent from "@testing-library/user-event";
import { describe, expect, it } from "vitest";
import Counter from "./Counter";

describe("Counter", () => {
  it("increments when +1 is clicked", async () => {
    const user = userEvent.setup();
    render(() => <Counter />);

    await user.click(screen.getByRole("button", { name: "+1" }));

    expect(screen.getByText("1")).toBeInTheDocument();
  });
});
",
  "src/components/SignupForm.jsx": "import { createForm } from "@tanstack/solid-form";
import { createSignal, Show } from "solid-js";
import { z } from "zod";

const schema = z.object({
  email: z.email("Enter a valid email address."),
});

export default function SignupForm() {
  const [joined, setJoined] = createSignal("");
  const form = createForm(() => ({
    defaultValues: { email: "" },
    validators: { onSubmit: schema },
    onSubmit: ({ value }) => setJoined(value.email),
  }));

  return (
    <Show
      when={!joined()}
      fallback={
        <p class="max-w-md text-center text-slate-600">
          Thanks, {joined()} is on the list.
        </p>
      }
    >
      <form
        noValidate
        class="flex w-full max-w-sm flex-col gap-3"
        onSubmit={(event) => {
          event.preventDefault();
          void form.handleSubmit();
        }}
      >
        <form.Field name="email">
          {(field) => (
            <label class="flex flex-col gap-1 text-sm font-medium">
              Email
              <input
                type="email"
                class="rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"
                name={field().name}
                value={field().state.value}
                onBlur={field().handleBlur}
                onInput={(event) =>
                  field().handleChange(event.currentTarget.value)
                }
              />
              <Show when={field().state.meta.errors[0]}>
                {(error) => (
                  <span role="alert" class="font-normal text-red-600">
                    {error().message}
                  </span>
                )}
              </Show>
            </label>
          )}
        </form.Field>
        <button
          type="submit"
          class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
        >
          Sign up
        </button>
      </form>
    </Show>
  );
}
",
  "src/components/StackList.jsx": "import { useQuery } from "@tanstack/solid-query";
import { Match, Switch } from "solid-js";
import { fetchStack } from "../api/stack";

export default function StackList() {
  const stack = useQuery(() => ({ queryKey: ["stack"], queryFn: fetchStack }));

  return (
    <p class="max-w-md text-center text-slate-600">
      <Switch>
        <Match when={stack.isPending}>Loading…</Match>
        <Match when={stack.isError}>Could not load the stack.</Match>
        <Match when={stack.data}>
          {(data) => \`Built with \${data().join(", ")}.\`}
        </Match>
      </Switch>
    </p>
  );
}
",
  "src/index.css": "@import "tailwindcss";
",
  "src/index.jsx": "/* @refresh reload */
import { Route, Router } from "@solidjs/router";
import { QueryClient, QueryClientProvider } from "@tanstack/solid-query";
import { render } from "solid-js/web";
import App from "./App";
import About from "./pages/About";
import Home from "./pages/Home";
import "./index.css";

const queryClient = new QueryClient();

const root = document.getElementById("root");

render(
  () => (
    <QueryClientProvider client={queryClient}>
      <Router root={App}>
        <Route path="/" component={Home} />
        <Route path="/about" component={About} />
      </Router>
    </QueryClientProvider>
  ),
  root,
);
",
