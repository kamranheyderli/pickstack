  "src/app/api/stack.ts": "/** Loads the stack list served from \`public/stack.json\`. */
export async function fetchStack(): Promise<string[]> {
  const response = await fetch("stack.json");
  if (!response.ok) throw new Error(\`Request failed: \${response.status}\`);
  return response.json();
}
",
  "src/app/app.config.ts": "import {
  type ApplicationConfig,
  provideBrowserGlobalErrorListeners,
} from "@angular/core";
import { provideRouter } from "@angular/router";
import { provideTanStackQuery, QueryClient } from "@tanstack/angular-query";
import { routes } from "./app.routes";

export const appConfig: ApplicationConfig = {
  providers: [
    provideBrowserGlobalErrorListeners(),
    provideRouter(routes),
    provideTanStackQuery(() => new QueryClient()),
  ],
};
",
  "src/app/app.html": "<main
  class="flex min-h-screen flex-col items-center justify-center gap-8 bg-slate-50 p-8 text-slate-900"
>
  <nav class="flex gap-4 text-sm font-medium">
    <a class="text-slate-600 hover:text-slate-900" routerLink="/">Home</a>
    <a class="text-slate-600 hover:text-slate-900" routerLink="/about">About</a>
  </nav>
  <router-outlet />
</main>
",
  "src/app/app.routes.ts": "import type { Routes } from "@angular/router";
import { Home } from "./pages/home/home";

export const routes: Routes = [
  { path: "", component: Home, title: "my-app" },
  {
    path: "about",
    title: "About | my-app",
    loadComponent: () => import("./pages/about/about").then((m) => m.About),
  },
];
",
