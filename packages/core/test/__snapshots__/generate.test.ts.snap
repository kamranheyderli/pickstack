  "README.md": "# my-app

Stack: Astro, TypeScript, Sass, Tailwind CSS, Axios, Playwright, Vitest, ESLint, Prettier, Husky, lint-staged, SEO, llms.txt, GitHub Actions.

## Getting started

\`\`\`bash
npm install
npm run dev
\`\`\`

## Scripts

- \`npm run build\`
- \`npm run preview\`
- \`npm run astro\`
- \`npm run typecheck\`
- \`npm run test:e2e\`
- \`npm run test\`
- \`npm run lint\`
- \`npm run format\`
- \`npm run format:check\`
- \`npm run prepare\`
- \`npm run deploy\`

## API client

Copy \`.env.example\` to \`.env\` and set \`PUBLIC_API_URL\`. Import the client from \`src/api/client\`.

## End-to-end tests

Install the browser once, then run the tests (they start the dev server themselves):

\`\`\`sh
npx playwright install chromium
npm run test:e2e
\`\`\`

## Git hooks

The pre-commit hook runs lint-staged on staged files (lint-staged needs Node.js 22.22.1 or newer). Hooks are installed by \`prepare\` during install, which needs a git repository: after \`git init\`, run the install once more.

## License

MIT, see \`LICENSE\`.

## Deploy to Cloudflare

Run \`npm run deploy\`: it builds the site and uploads it to Cloudflare Workers. The first run opens a browser to log in.

To deploy from GitHub instead, connect the repository in the Cloudflare dashboard (Workers & Pages → Create → Import a repository).

## Docker

\`\`\`sh
docker build -t my-app .
docker run --rm -p 8080:80 my-app
\`\`\`

Then open http://localhost:8080.

## Deploy to Netlify

Push the project to GitHub and import it at https://app.netlify.com/start.
\`netlify.toml\` sets the build command and the folder to publish.

Or deploy from the terminal with \`npx netlify-cli deploy\`.

## Deploy to Vercel

Push the project to GitHub and import it at https://vercel.com/new. Vercel detects Astro and needs no build settings.

Or deploy from the terminal with \`npx vercel\`.

## Claude Code

\`CLAUDE.md\` (with \`AGENTS.md\`) describes the project, \`.claude/settings.json\` allows the project's scripts and formats edited files, and \`.mcp.json\` lists MCP servers for the stack (Claude Code asks before enabling them).

## SEO

Set \`SITE_URL\` to your public origin (defaults to \`https://example.com\`). It is used for canonical URLs, the sitemap, robots.txt and llms.txt.

## Push to GitHub

Create an empty repository on GitHub, then:

\`\`\`bash
git init
git add .
git commit -m "Initial commit"
git branch -M main
git remote add origin https://github.com/<your-username>/my-app.git
git push -u origin main
\`\`\`
",
  "astro.config.mjs": "// @ts-check
import sitemap from "@astrojs/sitemap";
import tailwindcss from "@tailwindcss/vite";
import { defineConfig } from "astro/config";

// https://astro.build/config
export default defineConfig({
  site: process.env.SITE_URL ?? "https://example.com",
  integrations: [sitemap()],
  vite: {
    plugins: [tailwindcss()],
  },
});
",
  "e2e/app.e2e.ts": "import { expect, test } from "@playwright/test";

test("the counter goes up", async ({ page }) => {
  await page.goto("/");
  // Clicks before hydration are lost, so retry until the count changes.
  await expect(async () => {
    await page.getByRole("button", { name: "+1" }).click();
    await expect(page.getByText("1", { exact: true })).toBeVisible({
      timeout: 1000,
    });
  }).toPass();
});

test("the about page opens from the nav", async ({ page }) => {
  await page.goto("/");
  await page.getByRole("link", { name: "About" }).click();
  await expect(page).toHaveURL(/about/);
  await expect(page.getByRole("heading", { name: "About" })).toBeVisible();
});
",
  "eslint.config.js": "import js from "@eslint/js";
import { defineConfig, globalIgnores } from "eslint/config";
import eslintConfigPrettier from "eslint-config-prettier/flat";
import eslintPluginAstro from "eslint-plugin-astro";
import globals from "globals";
import tseslint from "typescript-eslint";

export default defineConfig([
  globalIgnores(["dist", ".astro"]),
  js.configs.recommended,
  tseslint.configs.recommended,
  eslintPluginAstro.configs.recommended,
  {
    languageOptions: {
      globals: { ...globals.browser, ...globals.node },
    },
  },
  eslintConfigPrettier,
]);
",
  "netlify.toml": "[build]
  command = "npm run build"
  publish = "dist"
",
  "nginx.conf": "server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Hashed file names change with every build, so they can be cached for good.
  location /_astro/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri $uri.html $uri/ =404;
  }

  error_page 404 /404.html;
}
",
  "package.json": "{
  "name": "my-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,astro})": "prettier --ignore-unknown --write"
  },
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
",
  "playwright.config.ts": "import process from "node:process";
import { defineConfig, devices } from "@playwright/test";

export default defineConfig({
  testDir: "./e2e",
  testMatch: "**/*.e2e.?(c|m)[jt]s",
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 0,
  reporter: "html",
  use: { baseURL: "http://localhost:4321", trace: "on-first-retry" },
  projects: [{ name: "chromium", use: { ...devices["Desktop Chrome"] } }],
  webServer: {
    command: "npm run dev -- --ignore-lock",
    url: "http://localhost:4321",
    reuseExistingServer: !process.env.CI,
  },
});
",
  "src/api/client.ts": "import axios from "axios";

export const api = axios.create({
  baseURL: import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000",
  timeout: 10_000,
});
",
  "src/components/Counter.astro": "<counter-card>
  <div class="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
    <p class="text-5xl font-bold tabular-nums" data-count>
      0
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <button
        type="button"
        class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
        data-step="-1"
      >
        -1
      </button>
      <button
        type="button"
        class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
        data-step="1"
      >
        +1
      </button>
    </div>
  </div>
</counter-card>

<script>
  class CounterCard extends HTMLElement {
    connectedCallback() {
      const output = this.querySelector("[data-count]");
      let count = 0;
      for (const button of this.querySelectorAll("button")) {
        button.addEventListener("click", () => {
          count += Number(button.dataset.step);
          if (output) output.textContent = String(count);
        });
      }
    }
  }

  customElements.define("counter-card", CounterCard);
</script>
",
  "src/components/Counter.test.ts": "import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { describe, expect, it } from "vitest";
import Counter from "./Counter.astro";

describe("Counter", () => {
  it("renders the count and both buttons", async () => {
    const container = await AstroContainer.create();
    const html = await container.renderToString(Counter);

    expect(html).toMatch(/data-count[^>]*>\\s*0\\s*</);
    expect(html).toContain('data-step="1"');
    expect(html).toContain('data-step="-1"');
  });
});
",
  "src/layouts/Layout.astro": "---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "my-app",
  url: Astro.site?.href,
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content="my-app: a web app." />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <main class="flex min-h-screen flex-col items-center justify-center gap-8 bg-slate-50 p-8 text-slate-900">
      <nav class="flex gap-4 text-sm font-medium">
        <a class="text-slate-600 hover:text-slate-900" href="/">
          Home
        </a>
        <a class="text-slate-600 hover:text-slate-900" href="/about">
          About
        </a>
      </nav>
      <slot />
    </main>
  </body>
</html>
",
  "src/pages/about.astro": "---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About">
  <section class="flex flex-col items-center gap-6">
    <h1 class="text-3xl font-bold tracking-tight">About</h1>
    <p class="max-w-md text-center text-slate-600">
      Built with Astro, TypeScript, Sass, Tailwind CSS, Axios, Playwright,
      Vitest, ESLint, Prettier, Husky, lint-staged, SEO, llms.txt, GitHub
      Actions.
    </p>
  </section>
</Layout>
",
  "src/pages/index.astro": "---
import Counter from "../components/Counter.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <section class="flex flex-col items-center gap-6">
    <h1 class="text-3xl font-bold tracking-tight">my-app</h1>
    <Counter />
  </section>
</Layout>
",
  "src/pages/llms.txt.ts": "import type { APIRoute } from "astro";

export const GET: APIRoute = ({ site }) => {
  const siteUrl = (site?.href ?? "/").replace(/\\/$/, "");
  return new Response(\`# my-app

> my-app: a web app.

## Pages

- [Home](\${siteUrl}/)
- [About](\${siteUrl}/about)

## Optional

- [Sitemap](\${siteUrl}/sitemap.xml)
\`);
};
",
  "src/pages/robots.txt.ts": "import type { APIRoute } from "astro";

export const GET: APIRoute = ({ site }) => {
  const siteUrl = (site?.href ?? "/").replace(/\\/$/, "");
  return new Response(\`User-agent: *
Content-Signal: search=yes, ai-input=yes, ai-train=no
Allow: /

User-agent: GPTBot
User-agent: ClaudeBot
User-agent: Google-Extended
User-agent: Applebot-Extended
User-agent: meta-externalagent
User-agent: CCBot
User-agent: Bytespider
Disallow: /

Sitemap: \${siteUrl}/sitemap-index.xml
\`);
};
",
  "src/styles/global.css": "@import "tailwindcss";
",
  "tsconfig.json": "{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
",
  "vitest.config.ts": "/// <reference types="vitest/config" />
import { getViteConfig } from "astro/config";

export default getViteConfig({
  test: {},
});
",
  "wrangler.json": "{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page"
  }
}
",
}
`;

