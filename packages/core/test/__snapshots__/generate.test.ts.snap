    "vite": "^8.3.8"
  }
}
",
  "src/App.jsx": "import { Route, Router } from "preact-iso";
import About from "./pages/About";
import Home from "./pages/Home";

export default function App() {
  return (
    <main class="flex min-h-screen flex-col items-center justify-center gap-8 bg-slate-50 p-8 text-slate-900">
      <nav class="flex gap-4 text-sm font-medium">
        <a class="text-slate-600 hover:text-slate-900" href="/">
          Home
        </a>
        <a class="text-slate-600 hover:text-slate-900" href="/about">
          About
        </a>
      </nav>
      <Router>
        <Route path="/" component={Home} />
        <Route path="/about" component={About} />
      </Router>
    </main>
  );
}
",
  "src/api/client.js": "import axios from "axios";

export const api = axios.create({
  baseURL: import.meta.env.VITE_API_URL ?? "http://localhost:3000",
  timeout: 10_000,
});
",
  "src/components/Counter.jsx": "import { useState } from "preact/hooks";

export default function Counter() {
  const [count, setCount] = useState(0);

  return (
    <div class="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
      <p class="text-5xl font-bold tabular-nums">{count}</p>
      <div class="mt-6 flex justify-center gap-3">
        <button
          class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={() => setCount((value) => value - 1)}
        >
          -1
        </button>
        <button
          class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={() => setCount((value) => value + 1)}
        >
          +1
        </button>
      </div>
    </div>
  );
}
",
  "src/index.css": "@import "tailwindcss";
",
  "src/main.jsx": "import { render } from "preact";
import { LocationProvider } from "preact-iso";
import App from "./App";
import "./index.css";

render(
  <LocationProvider>
    <App />
  </LocationProvider>,
  document.getElementById("app"),
);
",
  "src/pages/About.jsx": "export default function About() {
  return (
    <section class="flex flex-col items-center gap-6">
      <h1 class="text-3xl font-bold tracking-tight">About</h1>
      <p class="max-w-md text-center text-slate-600">
        Built with Preact, Vite, Tailwind CSS, preact-iso, Axios, Prettier.
      </p>
    </section>
  );
}
",
  "src/pages/Home.jsx": "import Counter from "../components/Counter";

export default function Home() {
  return (
    <section class="flex flex-col items-center gap-6">
      <h1 class="text-3xl font-bold tracking-tight">my-app</h1>
      <Counter />
    </section>
  );
}
