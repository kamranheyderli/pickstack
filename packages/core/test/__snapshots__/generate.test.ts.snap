  "app/todos/page.tsx" => "import { desc } from "drizzle-orm";
import { revalidatePath } from "next/cache";
import { connection } from "next/server";
import { db } from "@/db";
import { todos } from "@/db/schema";

async function addTodo(formData: FormData) {
  "use server";
  const title = String(formData.get("title") ?? "").trim();
  if (!title) return;
  await db.insert(todos).values({ title: title.slice(0, 200) });
  revalidatePath("/todos");
}

export default async function Todos() {
  // Render per request: the database is not there when the app is built.
  await connection();
  const rows = await db
    .select()
    .from(todos)
    .orderBy(desc(todos.createdAt))
    .limit(100)
    .catch(() => null);

  return (
    <section className="flex flex-col items-center gap-6">
      <h1 className="text-3xl font-bold tracking-tight">Todos</h1>
      <form action={addTodo} className="mt-6 flex justify-center gap-3">
        <input
          className="rounded-lg border border-slate-300 px-3 py-2"
          name="title"
          required
          maxLength={200}
          placeholder="What needs doing?"
        />
        <button
          className="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          type="submit"
        >
          Add
        </button>
      </form>
      {rows ? (
        <ul>
          {rows.map((todo) => (
            <li key={todo.id}>{todo.title}</li>
          ))}
        </ul>
      ) : (
        <p className="max-w-md text-center text-slate-600">
          The database isn&apos;t ready: run docker compose up -d, then npm run
          db:push.
        </p>
      )}
    </section>
  );
}
",
  "components/Counter.tsx" => ""use client";

import { useState } from "react";

export default function Counter() {
  const [count, setCount] = useState(0);

  return (
    <div className="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
      <p className="text-5xl font-bold tabular-nums">{count}</p>
      <div className="mt-6 flex justify-center gap-3">
        <button
          type="button"
          className="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={() => setCount((n) => n - 1)}
        >
          -1
        </button>
        <button
          type="button"
          className="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
          onClick={() => setCount((n) => n + 1)}
        >
          +1
        </button>
      </div>
    </div>
  );
}
",
  "db/index.ts" => "import { drizzle } from "drizzle-orm/node-postgres";
import { Pool } from "pg";

// Connects lazily: the first query opens a connection.
const pool = new Pool({
  connectionString:
    process.env.DATABASE_URL ??
    "postgres://postgres:postgres@localhost:5432/my-app",
});
// An idle connection can drop (e.g. Postgres restarts); without a listener that crashes the process.
pool.on("error", (error) =>
  console.error("Postgres pool error:", error.message),
);

export const db = drizzle({ client: pool });
",
  "db/schema.ts" => "import {
  boolean,
  integer,
  pgTable,
  timestamp,
  varchar,
} from "drizzle-orm/pg-core";

export const todos = pgTable("todos", {
  id: integer().primaryKey().generatedAlwaysAsIdentity(),
  title: varchar({ length: 200 }).notNull(),
  done: boolean().notNull().default(false),
  createdAt: timestamp("created_at").notNull().defaultNow(),
});
",
  "docker-compose.yml" => "# Local PostgreSQL for development: docker compose up -d
services:
  postgres:
    image: postgres:18
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: my-app
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql

volumes:
  postgres-data:
",
  "drizzle.config.ts" => "import "dotenv/config";
import { defineConfig } from "drizzle-kit";

export default defineConfig({
  out: "./drizzle",
  schema: "./db/schema.ts",
  dialect: "postgresql",
  dbCredentials: {
    url:
      process.env.DATABASE_URL ??
      "postgres://postgres:postgres@localhost:5432/my-app",
  },
});
",
