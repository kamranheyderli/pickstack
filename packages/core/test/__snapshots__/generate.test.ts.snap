  "src/components/CounterCard.vue": "<script setup lang="ts">
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { useCounterStore } from "@/stores/counter";

const counter = useCounterStore();
</script>

<template>
  <Card class="w-72 text-center">
    <CardHeader>
      <CardTitle>Counter</CardTitle>
    </CardHeader>
    <CardContent>
      <p class="text-5xl font-bold tabular-nums">{{ counter.count }}</p>
    </CardContent>
    <CardFooter class="justify-center gap-3">
      <Button variant="outline" @click="counter.decrement()">-1</Button>
      <Button @click="counter.increment()">+1</Button>
    </CardFooter>
  </Card>
</template>
",
  "src/components/LanguageSwitcher.vue": "<script setup lang="ts">
import { useI18n } from "vue-i18n";

const { t, locale } = useI18n();
const languages = [
  { code: "en", label: "English" },
  { code: "es", label: "Español" },
];
</script>

<template>
  <div>
    <p class="max-w-md text-center text-slate-600">{{ t("greeting") }}</p>
    <div class="mt-6 flex justify-center gap-3">
      <button
        v-for="{ code, label } in languages"
        :key="code"
        type="button"
        class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
        :aria-pressed="locale === code"
        @click="locale = code"
      >
        {{ label }}
      </button>
    </div>
  </div>
</template>
",
  "src/components/SignupForm.vue": "<script setup lang="ts">
import { useForm } from "@tanstack/vue-form";
import { ref } from "vue";
import { z } from "zod";

const schema = z.object({
  email: z.email("Enter a valid email address."),
});

const joined = ref("");
const form = useForm({
  defaultValues: { email: "" },
  validators: { onSubmit: schema },
  onSubmit: ({ value }) => (joined.value = value.email),
});
</script>

<template>
  <p v-if="joined" class="max-w-md text-center text-slate-600">
    Thanks, {{ joined }} is on the list.
  </p>
  <form
    v-else
    novalidate
    class="flex w-full max-w-sm flex-col gap-3"
    @submit.prevent="form.handleSubmit()"
  >
    <form.Field name="email">
      <template #default="{ field }">
        <label class="flex flex-col gap-1 text-sm font-medium">
          Email
          <input
            type="email"
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"
            :name="field.name"
            :value="field.state.value"
            @blur="field.handleBlur"
            @input="
              (event) =>
                field.handleChange((event.target as HTMLInputElement).value)
            "
          />
          <span
            v-if="field.state.meta.errors[0]"
            role="alert"
            class="font-normal text-red-600"
          >
            {{ field.state.meta.errors[0].message }}
          </span>
        </label>
      </template>
    </form.Field>
    <button
      type="submit"
      class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700"
    >
      Sign up
    </button>
  </form>
</template>
",
  "src/components/StackList.vue": "<script setup lang="ts">
import { useQuery } from "@tanstack/vue-query";
import { fetchStack } from "../api/stack";

const { isPending, isError, data } = useQuery({
  queryKey: ["stack"],
  queryFn: fetchStack,
});
</script>

<template>
  <p v-if="isPending" class="max-w-md text-center text-slate-600">Loading…</p>
  <p v-else-if="isError" class="max-w-md text-center text-slate-600">
    Could not load the stack.
  </p>
  <p v-else class="max-w-md text-center text-slate-600">
    Built with {{ data?.join(", ") }}.
  </p>
</template>
",
  "src/components/__tests__/CounterCard.spec.ts": "import userEvent from "@testing-library/user-event";
import { render, screen } from "@testing-library/vue";
import { createPinia } from "pinia";
import { describe, expect, it } from "vitest";
import CounterCard from "../CounterCard.vue";

describe("CounterCard", () => {
  it("increments when +1 is clicked", async () => {
    const user = userEvent.setup();
    render(CounterCard, { global: { plugins: [createPinia()] } });

    await user.click(screen.getByRole("button", { name: "+1" }));

    expect(screen.getByText("1")).toBeInTheDocument();
  });
});
