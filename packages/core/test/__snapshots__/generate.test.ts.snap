  "netlify.toml": "[build]
  command = "npm run build"
  publish = "dist"

# Client-side routes: serve index.html for paths that aren't files.
[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200
",
  "nginx.conf": "server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Hashed file names change with every build, so they can be cached for good.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
