  "src/App.tsx": "import { Route, Router } from "preact-iso";
import About from "./pages/About";
import Home from "./pages/Home";

export default function App() {
  return (
    <main class="flex min-h-screen flex-col items-center justify-center gap-8 bg-slate-50 p-8 text-slate-900">
      <nav class="flex gap-4 text-sm font-medium">
        <a class="text-slate-600 hover:text-slate-900" href="/">
          Home
        </a>
        <a class="text-slate-600 hover:text-slate-900" href="/about">
          About
        </a>
      </nav>
      <Router>
        <Route path="/" component={Home} />
        <Route path="/about" component={About} />
      </Router>
    </main>
  );
}
