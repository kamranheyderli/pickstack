  "netlify.toml": "[build]
  command = "npm run build"
  publish = "dist"

# Client-side routes: serve index.html for paths that aren't files.
[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200
",
  "nginx.conf": "server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Hashed file names change with every build, so they can be cached for good.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
",
  "package.json": "{
  "name": "my-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs})": "prettier --ignore-unknown --write"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "preact": "^11.2.0",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.3"
  },
  "devDependencies": {
