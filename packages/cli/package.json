{
  "name": "create-pickstack",
  "version": "0.3.0",
  "description": "Create a web project with the stack you pick: framework, UI kit, state, routing, testing, linting, AI agent configs, and an optional Express or NestJS API with PostgreSQL or MongoDB.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-pickstack": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamranheyderli/pickstack.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "create",
    "fullstack",
    "express",
    "nestjs",
    "drizzle",
    "scaffold",
    "starter",
    "vite",
    "react",
    "vue",
    "svelte",
    "angular",
    "nextjs",
    "nuxt"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stackforge/core": "workspace:*",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
