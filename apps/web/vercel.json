{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "thepickstack.vercel.app" }],
      "destination": "https://pickstack.online/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pickstack-six.vercel.app" }],
      "destination": "https://pickstack.online/:path*",
      "permanent": true
    }
  ]
}
